# Application
NODE_ENV=development
WEB_PORT=3000
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
# Keep mock repositories/storage until managed services are ready.
PERSISTENCE_MODE=mock
STORAGE_MODE=mock
NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Optional: simulate a slow API in mock mode. Keep 0 for responsive local navigation.
NEXT_PUBLIC_MOCK_API_DELAY_MS=0

# Supabase browser client (public values only; optional until the web app uses supabase-js directly)
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key

# Supabase Storage (private server-side values; required when STORAGE_MODE=supabase)
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=lpms-documents

# Supabase PostgreSQL
# DATABASE_URL is the Supavisor transaction pooler URL for Vercel runtime.
# DIRECT_URL is only for migrations/administrative CLI commands.
DATABASE_URL=postgresql://prisma.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://prisma.project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# Optional Cloudflare R2 alternative (required only when STORAGE_MODE=r2)
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_BUCKET=lpms-documents
R2_ACCESS_KEY_ID=replace-with-scoped-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-scoped-r2-secret

# Vercel Queues
VERCEL_QUEUE_URL=replace-with-vercel-queue-configuration
# Web consumer only: public base URL of the deployed NestJS API.
QUEUE_PROCESSOR_URL=https://api-preview.example.vercel.app
QUEUE_INTERNAL_SECRET=replace-with-a-long-random-queue-consumer-secret
# Vercel Cron authorization secret for the daily reminder producer.
CRON_SECRET=replace-with-a-long-random-cron-secret

# Replace with long random values outside local development. Never commit real values.
JWT_ACCESS_SECRET=replace-with-a-long-random-development-secret-minimum-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-development-secret-minimum-32-chars
# Required when PERSISTENCE_MODE=prisma; used to encrypt MFA secrets at rest.
AUTH_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret-minimum-32-chars
# Optional, only used by `npm run db:seed` to create the first admin account.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=LPMS System Administrator
SEED_ADMIN_PASSWORD=replace-with-a-strong-one-time-bootstrap-password
